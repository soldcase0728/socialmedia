---
interface Props {
  eyebrow: string;
  h1: string;
  standfirst: string;
}
const { eyebrow, h1, standfirst } = Astro.props;
---
<header class="border-b border-hairline">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:py-20">
    <p class="label text-red">{eyebrow}</p>
    <h1 class="font-display mt-4 max-w-[20ch] text-4xl sm:text-5xl lg:text-6xl">{h1}</h1>
    <p class="measure mt-6 text-lg text-muted">{standfirst}</p>
  </div>
</header>
